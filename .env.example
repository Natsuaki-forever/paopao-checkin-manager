TARGET_URL=https://example.com/#/checkin
LOGIN_URL=https://example.com/#/login
TIMEZONE=Asia/Shanghai
CRON_EXPRESSION=0 0 8 * * *
HEADLESS=true
PROXY_SERVER=http://mihomo:7890
NAVIGATION_TIMEOUT_MS=60000
ACTION_TIMEOUT_MS=20000
RETRY_COUNT=2
RETRY_DELAY_MS=10000

# 目标网站登录凭据。只保存在服务器 .env 中，文件权限必须为 600。
LYNVX_EMAIL=
LYNVX_PASSWORD=

# 企业微信群机器人 Webhook。留空时仅记录日志。
WECHAT_WEBHOOK_URL=

# Server酱 SendKey。留空时不使用 Server酱。
SERVERCHAN_SENDKEY=

# 页面结构变化时可以覆盖这些配置。
CHECKIN_BUTTON_SELECTORS=.claim-button
SUCCESS_SELECTORS=
ALREADY_CHECKED_SELECTORS=
CHALLENGE_SELECTORS=iframe[src*="captcha"],iframe[src*="challenge"],iframe[src*="turnstile"],.captcha,.geetest_panel,.tcaptcha-transform,.cf-turnstile

CHECKIN_BUTTON_TEXTS=立即签到|每日签到|点击签到|签到
SUCCESS_TEXTS=签到成功|今日已签到|今天已签到|已完成签到
ALREADY_CHECKED_TEXTS=今日已签到|今天已签到|已完成签到
CHALLENGE_TEXTS=人机验证|安全验证|滑块验证|请完成验证
