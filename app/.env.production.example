CHECKIN_PUBLIC_ORIGIN=https://checkin.example.com

# Store this file outside the project data and backup directories. It must persist across upgrades.
CHECKIN_SECRET_HOST_PATH=/root/paopao-checkin-secrets/paopao-secret.key

# Internal proxy hostnames must be explicitly trusted. Public proxy hosts need not be listed.
CHECKIN_TRUSTED_PROXY_HOSTS=mihomo

# Progressive rollout flags. Keep disabled until each stage is verified.
CHECKIN_FEATURE_QUEUE=false
CHECKIN_FEATURE_SESSION=false
CHECKIN_FEATURE_HTTP_FLOW=false
